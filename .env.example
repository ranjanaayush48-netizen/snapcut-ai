# ==========================================
# SnapCut AI - Environment Configuration
# ==========================================

# ------------------------------------------
# Server Configuration (Backend)
# ------------------------------------------
# Cloud hosts (Render, Railway, Fly.io) inject PORT automatically - do NOT set it manually
# Leave PORT commented out unless you need a specific custom port
# PORT=5000
# HOST=0.0.0.0
NODE_ENV=production
# Set this to your Vercel frontend URL in production:
FRONTEND_URL=https://your-project-name.vercel.app

# ------------------------------------------
# Supabase / PostgreSQL Configuration
# ------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for Supabase Auth verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------
# n8n Cloud Automation Integration
# ------------------------------------------
# Your n8n Cloud webhook endpoint URL (Trigger node)
N8N_WEBHOOK_URL=https://ayushranjan2126.app.n8n.cloud/webhook/remove-background
# Shared secret for authenticating requests between SnapCut backend & n8n Cloud
N8N_WEBHOOK_SECRET=your-secure-n8n-webhook-secret-token

# ------------------------------------------
# Cloudinary Storage Configuration
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Asset retention time in seconds before auto-cleanup (default: 86400 = 24 hours)
IMAGE_RETENTION_SECONDS=86400

# ------------------------------------------
# AI Background Removal API
# ------------------------------------------
# Configurable AI provider: clipdrop | removebg | photomaker | mock
BACKGROUND_REMOVAL_PROVIDER=clipdrop
BACKGROUND_REMOVAL_API_URL=https://clipdrop-api.co/remove-background/v1
BACKGROUND_REMOVAL_API_KEY=your-ai-provider-api-key

# ------------------------------------------
# Razorpay Payments Configuration
# ------------------------------------------
# Razorpay Key ID (Safe for public checkout scripts)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
# Razorpay Key Secret (Server-only, NEVER expose to client)
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
# Webhook secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------
# Rate Limiting & Security
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------
# Frontend Environment Variables (Vite)
# Place these in client/.env
# ------------------------------------------
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
# VITE_TRADE_NAME=SnapCut AI
# VITE_LEGAL_NAME=SnapCut AI
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# VITE_SUPPORT_EMAIL=support@snapcut.ai
# VITE_BILLING_EMAIL=billing@snapcut.ai
# VITE_GRIEVANCE_EMAIL=grievance@snapcut.ai
# VITE_SUPPORT_PHONE=+91 98765 43210
# VITE_BUSINESS_ADDRESS=SnapCut AI, C/O Ayush Ranjan, Registered Office, City, State, PIN, India
# VITE_GRIEVANCE_OFFICER=Ayush Ranjan
# VITE_GSTIN=
